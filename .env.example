# Browser-safe project configuration only. Never put secrets under VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_public_key
VITE_SUPABASE_PROJECT_ID=your-project
# Server-only credentials belong in hosting secrets; never use VITE_ prefixes.
# GOOGLE_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# KINDLE_CLOUD_KEY= # 64 random hex characters, set only in hosting Secrets
# KINDLE_RELAY_PRIVATE_KEY= # Optional Ed25519 PKCS8 DER base64; hosting secret only
